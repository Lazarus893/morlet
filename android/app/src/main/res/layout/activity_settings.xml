<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="32dp">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:accessibilityHeading="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/settings_subtitle"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:lineSpacingMultiplier="1.3" />

        <!-- Overlay permission missing -->
        <LinearLayout
            android:id="@+id/perm_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:background="@drawable/warning_bg"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/perm_title"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/primary_dark" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/perm_body"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingMultiplier="1.3" />

            <Button
                android:id="@+id/btn_grant"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginTop="12dp"
                android:minWidth="96dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="@string/perm_action"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textColor="@color/text_on_primary"
                android:background="@drawable/btn_primary_bg"
                android:stateListAnimator="@null" />
        </LinearLayout>

        <!-- Recording -->
        <TextView style="@style/SettingsSection" android:text="@string/section_record" />

        <LinearLayout style="@style/SettingsCard">

            <LinearLayout style="@style/SettingsRow">
                <Switch
                    android:id="@+id/sw_record"
                    style="@style/SettingsSwitch"
                    android:text="@string/setting_record" />
                <TextView style="@style/SettingsDesc" android:text="@string/setting_record_desc" />
            </LinearLayout>

            <View style="@style/SettingsDivider" />

            <LinearLayout style="@style/SettingsRow">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/label_screenshot"
                        style="@style/SettingsTitle"
                        android:text="@string/setting_screenshot" />
                    <TextView android:id="@+id/val_screenshot" style="@style/SettingsValue" />
                </LinearLayout>
                <TextView style="@style/SettingsDesc" android:text="@string/setting_screenshot_desc" />
                <SeekBar
                    android:id="@+id/seek_screenshot"
                    style="@style/SettingsSeek" />
            </LinearLayout>

            <View style="@style/SettingsDivider" />

            <LinearLayout style="@style/SettingsRow">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/label_checkpoint"
                        style="@style/SettingsTitle"
                        android:text="@string/setting_checkpoint" />
                    <TextView android:id="@+id/val_checkpoint" style="@style/SettingsValue" />
                </LinearLayout>
                <TextView style="@style/SettingsDesc" android:text="@string/setting_checkpoint_desc" />
                <SeekBar
                    android:id="@+id/seek_checkpoint"
                    style="@style/SettingsSeek" />
            </LinearLayout>
        </LinearLayout>

        <!-- Screen-recording consent (MediaProjection) -->
        <LinearLayout
            style="@style/SettingsCard"
            android:layout_marginTop="12dp">
            <LinearLayout style="@style/SettingsRow">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/record_auth_title"
                            android:textSize="16sp"
                            android:textColor="@color/text_primary" />
                        <TextView
                            android:id="@+id/record_auth_status"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textSize="13sp"
                            android:textColor="@color/text_secondary"
                            android:accessibilityLiveRegion="polite" />
                    </LinearLayout>
                    <Button
                        android:id="@+id/btn_record_auth"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="12dp"
                        android:minWidth="96dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="@string/record_auth_button"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        android:textColor="@color/text_on_primary"
                        android:background="@drawable/btn_primary_bg"
                        android:stateListAnimator="@null" />
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/record_cast_note"
                    android:textSize="13sp"
                    android:textColor="@color/text_hint"
                    android:lineSpacingMultiplier="1.3" />
            </LinearLayout>
        </LinearLayout>

        <!-- Execution -->
        <TextView style="@style/SettingsSection" android:text="@string/section_run" />

        <LinearLayout style="@style/SettingsCard">
            <LinearLayout style="@style/SettingsRow">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/label_max_steps"
                        style="@style/SettingsTitle"
                        android:text="@string/setting_max_steps" />
                    <TextView android:id="@+id/val_max_steps" style="@style/SettingsValue" />
                </LinearLayout>
                <TextView style="@style/SettingsDesc" android:text="@string/setting_max_steps_desc" />
                <SeekBar
                    android:id="@+id/seek_max_steps"
                    style="@style/SettingsSeek" />
            </LinearLayout>
        </LinearLayout>

        <!-- While a task runs -->
        <TextView style="@style/SettingsSection" android:text="@string/section_floating" />

        <LinearLayout style="@style/SettingsCard">
            <LinearLayout style="@style/SettingsRow">
                <Switch
                    android:id="@+id/sw_bubble"
                    style="@style/SettingsSwitch"
                    android:text="@string/setting_bubble" />
                <TextView style="@style/SettingsDesc" android:text="@string/setting_bubble_desc" />
            </LinearLayout>

            <View style="@style/SettingsDivider" />

            <LinearLayout style="@style/SettingsRow">
                <Switch
                    android:id="@+id/sw_overlay"
                    style="@style/SettingsSwitch"
                    android:text="@string/setting_overlay" />
                <TextView style="@style/SettingsDesc" android:text="@string/setting_overlay_desc" />
            </LinearLayout>
        </LinearLayout>

        <!-- Takeover -->
        <Button
            android:id="@+id/btn_takeover"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:text="@string/takeover_button"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:textColor="@color/text_on_primary"
            android:background="@drawable/btn_primary_bg"
            android:stateListAnimator="@null" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_horizontal"
            android:text="@string/takeover_hint"
            android:textSize="13sp"
            android:textColor="@color/text_hint" />

        <!-- Task status pushed from the Mac -->
        <TextView style="@style/SettingsSection" android:text="@string/section_status" />

        <LinearLayout
            android:id="@+id/status_card"
            style="@style/SettingsCard"
            android:orientation="horizontal"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:accessibilityLiveRegion="polite">

            <View
                android:id="@+id/status_dot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginTop="7dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/status_dot" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/status_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/status_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingMultiplier="1.3" />

                <TextView
                    android:id="@+id/status_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textSize="12sp"
                    android:textColor="@color/text_hint" />

                <TextView
                    android:id="@+id/status_record"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
