<?xml version="1.0" encoding="utf-8"?>
<!-- Text input dialog: modern card with improved input experience -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_bg"
    android:padding="@dimen/dialog_padding"
    android:minWidth="@dimen/dialog_min_width"
    android:elevation="@dimen/dialog_elevation">

    <!-- Accent bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp"
        android:background="@color/primary" />

    <TextView
        android:id="@+id/dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dialog_input_title"
        android:textSize="@dimen/title_size"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/dialog_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="@dimen/body_size"
        android:textColor="@color/text_secondary"
        android:lineSpacingMultiplier="1.4"
        android:layout_marginBottom="20dp" />

    <!-- Improved text input: multiline, rounded outline -->
    <EditText
        android:id="@+id/edit_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/input_min_height"
        android:hint="@string/input_hint"
        android:textColorHint="@color/text_hint"
        android:textSize="@dimen/body_size"
        android:textColor="@color/text_primary"
        android:lineSpacingMultiplier="1.3"
        android:inputType="textMultiLine|textCapSentences"
        android:gravity="top|start"
        android:background="@drawable/input_bg"
        android:padding="@dimen/input_padding"
        android:layout_marginBottom="8dp"
        android:overScrollMode="always"
        android:scrollbars="vertical"
        android:maxLines="6" />

    <!-- Character count hint -->
    <TextView
        android:id="@+id/char_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:text=""
        android:textSize="12sp"
        android:textColor="@color/text_hint"
        android:layout_marginBottom="20dp" />

    <Button
        android:id="@+id/btn_submit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_submit"
        android:textSize="16sp"
        android:textColor="@color/text_on_primary"
        android:textAllCaps="false"
        android:textStyle="bold"
        android:background="@drawable/btn_primary_bg"
        android:paddingTop="@dimen/btn_padding_v"
        android:paddingBottom="@dimen/btn_padding_v" />

</LinearLayout>
