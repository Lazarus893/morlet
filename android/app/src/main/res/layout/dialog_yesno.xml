<?xml version="1.0" encoding="utf-8"?>
<!-- Yes/No dialog: modern card with warm palette -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_bg"
    android:padding="@dimen/dialog_padding"
    android:minWidth="@dimen/dialog_min_width"
    android:elevation="@dimen/dialog_elevation">

    <!-- Accent bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp"
        android:background="@color/primary" />

    <TextView
        android:id="@+id/dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dialog_yesno_title"
        android:textSize="@dimen/title_size"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/dialog_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="@dimen/body_size"
        android:textColor="@color/text_secondary"
        android:lineSpacingMultiplier="1.4"
        android:layout_marginBottom="28dp" />

    <!-- Button row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btn_no"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_no"
            android:textSize="15sp"
            android:textColor="@color/btn_secondary_text"
            android:textAllCaps="false"
            android:background="@drawable/btn_secondary_bg"
            android:paddingTop="@dimen/btn_padding_v"
            android:paddingBottom="@dimen/btn_padding_v"
            android:layout_marginEnd="12dp" />

        <Button
            android:id="@+id/btn_yes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_yes"
            android:textSize="15sp"
            android:textColor="@color/text_on_primary"
            android:textAllCaps="false"
            android:background="@drawable/btn_primary_bg"
            android:paddingTop="@dimen/btn_padding_v"
            android:paddingBottom="@dimen/btn_padding_v" />

    </LinearLayout>

</LinearLayout>
