<?xml version="1.0" encoding="utf-8"?>
<!-- Floating takeover pill shown while a task runs. Kept small so it never covers much. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@drawable/bubble_bg"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:clickable="true"
    android:focusable="false">

    <TextView
        android:id="@+id/bubble_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/bubble_title"
        android:textSize="11sp"
        android:textColor="@color/text_overlay_sub"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/bubble_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text="@string/bubble_action"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/text_on_primary"
        android:importantForAccessibility="no" />
</LinearLayout>
