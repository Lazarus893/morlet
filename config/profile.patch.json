[
  {
    "id": "agent-default-model",
    "config": {
      "provider": "deepseek-official",
      "model": "deepseek-flash"
    }
  },
  {
    "id": "system-prompt",
    "config": {
      "personaPrefix": "{{PERSONA_PREFIX}}",
      "personaSuffix": "{{PERSONA_SUFFIX}}"
    }
  },
  {
    "id": "sandbox-policy",
    "config": {
      "mode": "workspace-write",
      "workspaceRoot": "{{WORKSPACE}}"
    }
  },
  {
    "id": "bash-sandbox",
    "config": {
      "timeoutMs": 420000,
      "maxTimeoutMs": 900000
    }
  },
  {
    "id": "web-fetch-http",
    "config": {
      "maxBodyChars": 1000000
    }
  },
  {
    "id": "tool-web",
    "config": {
      "fetchMaxOutputChars": 1000000
    }
  },
  {
    "id": "weixin-channel",
    "config": {
      "credentialRef": "WEIXIN_ILINK_CREDENTIAL",
      "agentPreset": "xiaoman",
      "cwd": "{{WORKSPACE}}",
      "permissionPreset": "workspace-write",
      "statePath": "{{PROFILE}}/weixin/sync.json",
      "controlSocketPath": "{{SOCKET}}",
      "autoLogin": false,
      "imageInputMode": "auto"
    }
  },
  {
    "insert": [
      {
        "id": "hooks-intent-route",
        "name": "@deepseek-ai/dsh-hooks-claude-code",
        "config": {
          "configPath": "{{PROFILE}}/hooks.json",
          "projectDir": "{{WORKSPACE}}",
          "defaultTimeoutMs": 20000
        }
      }
    ]
  },
  {
    "insert": [
      {
        "id": "phone-context",
        "name": "{{ROOT}}/plugins/phone-context/index.js",
        "config": {
          "intervalMs": 8000
        }
      }
    ]
  },
  {
    "insert": [
      {
        "id": "log-to-file",
        "name": "{{ROOT}}/plugins/log-to-file/index.js"
      }
    ]
  },
  {
    "id": "storage-json",
    "config": {
      "root": "{{PROFILE}}/storages"
    }
  },
  {
    "id": "settings",
    "config": {
      "path": "{{PROFILE}}/settings.yaml"
    }
  }
]
