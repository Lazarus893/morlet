# Copy to .env and set your own values. Never commit .env.
# Run pa.sh init to choose agent, IM access and device adapters.
# DEEPSEEK_API_KEY is only needed for the DSH core/optional intent router.
# Codex/WorkBuddy use their own local CLI login; do not copy another user's auth.
DEEPSEEK_API_KEY=""
PHONE_AGENT_DEVICE_ID=""
PHONE_AGENT_BASE_URL=""
PHONE_AGENT_MODEL="autoglm-phone"
PHONE_AGENT_API_KEY=""
XIAOMAN_PORT=3082
# Optional Web port and externally published origin (no personal server is bundled).
# PA_WEB_PORT=3083
# PA_WEB_ORIGIN="https://your-server.example"
# Deployment operator: registered X Native App (public OAuth 2.0 client).
# Users only click Connect X and consent; never ask them for application keys.
# Register callback exactly http://127.0.0.1:3094/oauth/x/callback
# PA_X_CLIENT_ID=""
# Optional intent routing; a custom endpoint requires its own explicit key.
# INTENT_ENABLED=true
# INTENT_MODEL="deepseek-flash"
# INTENT_API_URL="https://your-model.example/v1/chat/completions"
# INTENT_API_KEY=""
# Optional LaunchAgent timezone; omitted means the operating system's timezone.
# TZ="Etc/UTC"
# Optional: ADB="/path/to/adb"
# Optional: XIAOMAN_CLOUD_REMOTE="xiaoman-cloud:xiaoman-shared"
# PHONE_AGENT_DEVICE_ID overrides the ID in pa.json. Clear it when changing phones.
